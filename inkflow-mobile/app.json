{
  "expo": {
    "name": "Inkflow Pro",
    "slug": "inkflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inkflowpro",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.inkflow.studio",
      "associatedDomains": [
        "applinks:app.ink-flow.me",
        "applinks:ink-flow.me"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "InkFlow utilise l’appareil photo pour ajouter des références, flashs et photos de séance.",
        "NSPhotoLibraryUsageDescription": "InkFlow utilise la photothèque pour importer des références client, flashs et documents de séance.",
        "NSPhotoLibraryAddUsageDescription": "InkFlow peut enregistrer des visuels ou documents générés pour ton studio.",
        "NSMicrophoneUsageDescription": "InkFlow peut utiliser le micro uniquement si une capture vidéo de séance est lancée depuis l’app.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "me.inkflow.studio",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.ink-flow.me",
              "pathPrefix": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "ink-flow.me"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "tapToPayCheck": true,
          "bluetoothBackgroundMode": false,
          "locationWhenInUsePermission": "InkFlow utilise ta position pour sécuriser les paiements Tap to Pay en salon."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4248109e-18f1-4a49-8619-58cd516cc190"
      }
    }
  }
}
