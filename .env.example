# ============================================================
# InkFlow - Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Pour Vercel : Settings → Environment Variables
# ============================================================

# --- FRONTEND (Vite) ---
# Ces variables sont exposées côté client (préfixe VITE_)

# Supabase (OBLIGATOIRE pour auth, base de données, sync)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Founder dashboard privé /admin — e-mails autorisés (minuscules OK, séparés par des virgules).
# Doit être le MÊME compte que la connexion Supabase (Google / magic link) que pour FOUNDER_ADMIN_EMAILS.
# Si tu omets cette ligne, le front n’affiche plus le blocage « Espace réservé » — seul le secret Edge ci-dessous filtre.
# Comptes *@ink-flow.me (et *@inkflow.me) = équipe interne (pas de fiche studio tatoueur à l’inscription).
# VITE_FOUNDER_ADMIN_EMAILS=fondateur@exemple.com
#
# Dev local uniquement — si VITE_FOUNDER_ADMIN_EMAILS est rempli sans ton e-mail de test, mets true pour débloquer l’UI /admin.
# Jamais utilisé en build production (Vite DEV=false).
# VITE_ADMIN_DEV_OPEN=true

# Même URL et clé anon que ci-dessus (sans préfixe VITE_) — middleware Edge (aperçus OG Instagram/WhatsApp).
# Sur Vercel, si le middleware ne voit pas les VITE_*, dupliquez-les ici pour le runtime Edge.
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_ANON_KEY=votre_cle_anon_supabase

# PostHog (optionnel) — product analytics, funnels, session replay. Opt-in : bannière cookies « Tout accepter ».
# Hébergement EU recommandé (RGPD). Clé = Project API key (Project settings → API).
# VITE_POSTHOG_KEY=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
#
# Lien de parrainage client (/invite/CODE) — en dev, sans ça le lien copié reste http://localhost:…
# Production : même URL que l’app hébergée (Vercel)
# VITE_PUBLIC_INVITE_ORIGIN=https://app.ink-flow.me
# (alternative) VITE_APP_URL=https://app.ink-flow.me
# Supabase → Authentication → URL Configuration
#
# Site URL : https://app.ink-flow.me  (l’app Vite — PAS la landing Framer https://ink-flow.me)
# Si Site URL = ink-flow.me, les erreurs de lien magique (#error=otp_expired, etc.) redirigent
# vers la landing au lieu de l’app ; les utilisateurs ne voient pas la page /client.
# Reset mot de passe : redirectTo = https://app.ink-flow.me/reset-password (pas ink-flow.me).
#
# Redirect URLs (magic link client) :
# https://app.ink-flow.me/client
# http://localhost:5173/client
# (anciens liens) https://app.ink-flow.me/auth/callback/client — peut rester listé
# Ajouter aussi :
#   https://app.ink-flow.me/auth/callback
#   http://localhost:5173/client (dev)
#
# Edge Function send-client-magic-link : secret APP_URL=https://app.ink-flow.me (même base que l’app)

# Stripe — clé publique (optionnel, pour Stripe Elements ou intégrations client)
# À configurer en production : Vercel → Settings → Environment Variables
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
#
# Stripe Terminal simulateur web (dev uniquement).
# true = lecteur simulé Stripe, nécessite des clés sk_test/pk_test côté Stripe.
# STRIPE_SECRET_KEY sur Supabase (Edge) doit être sk_test — sinon erreur « Only test mode keys… ».
# vide/false = recherche un vrai lecteur Stripe. Ne pas activer avec des clés live.
# VITE_STRIPE_TERMINAL_SIMULATOR=true

# (Optionnel) Sign in with Apple — masquer le bouton si le fournisseur n’est pas prêt (défaut : visible)
# Voir : https://supabase.com/docs/guides/auth/social-login/auth-apple
# VITE_ENABLE_APPLE_AUTH=false

# TURNSTILE_SECRET_KEY sur Supabase (Edge) pour le même site Turnstile. Voir docs/AUTH-HARDENING.md
# VITE_TURNSTILE_SITE_KEY=0x4AAAA...

# (Secrets Supabase uniquement — pas ici) UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN pour le rate
# limit des Edge Functions send-studio-auth-link et send-password-recovery. Voir docs/AUTH-HARDENING.md

# Stripe Billing — liens annuels (optionnel, sinon = mensuel)
# Créez des Payment Links annuels dans Stripe Dashboard et collez les URLs ici
# VITE_STRIPE_BILLING_SOLO_ANNUAL=https://buy.stripe.com/xxx
# VITE_STRIPE_BILLING_PRO_ANNUAL=https://buy.stripe.com/xxx
# VITE_STRIPE_BILLING_STUDIO_ANNUAL=https://buy.stripe.com/xxx

# --- SUPABASE EDGE FUNCTIONS (Secrets) ---
# À configurer dans : Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Ces variables ne vont PAS dans .env.local (elles sont côté serveur Supabase)

# Founder /admin — même liste d’e-mails que VITE_FOUNDER_ADMIN_EMAILS (séparés par des virgules).
# FOUNDER_ADMIN_EMAILS=fondateur@exemple.com
# Optionnel — MRR estimé (€ / mois) si les plans diffèrent du défaut 29 / 49 / 99 :
# FOUNDER_MRR_SOLO_EUR=29
# FOUNDER_MRR_PRO_EUR=49
# FOUNDER_MRR_STUDIO_EUR=99
#
# Founder /admin — KPIs agrégés : par défaut uniquement les studios « réels » (tatoueurs), pas les comptes de test.
# Liste d’e-mails (même propriétaire que inkflow_studios.email), séparés par des virgules.
# Défaut côté Edge si non défini : luiink.stories.pro@gmail.com, safeplacerouen@gmail.com
# FOUNDER_METRICS_STUDIO_EMAILS=luiink.stories.pro@gmail.com,safeplacerouen@gmail.com
# Pour inclure toute la plateforme dans les métriques (debug interne) :
# FOUNDER_METRICS_INCLUDE_ALL_STUDIOS=true

# Google Places (avis vitrine) — Edge Function `google-places` uniquement
# GOOGLE_PLACES_API_KEY=xxx   (ou GOOGLE_MAPS_API_KEY)
# Déployer la fonction avec JWT désactivé pour `public_reviews` si besoin : supabase functions deploy google-places --no-verify-jwt

# OAuth « Connecter Google Business » (API Account Management — quotas + validation Google Cloud).
# Par défaut l’UI est masquée : utilisez le Place ID dans Paramètres > Établissement + témoignages manuels (MVP).
# Mettre à true uniquement quand le projet Cloud est approuvé et la fonction edge `google-business-auth` est prête.
# VITE_GOOGLE_BUSINESS_OAUTH_ENABLED=true

# Google Calendar OAuth
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=votre_client_secret
# Dev (port Vite = 3000) : URI EXACTE dans Google Cloud Console
# GOOGLE_REDIRECT_URI=http://localhost:3000/dashboard
# Prod : URL de retour OAuth réelle (souvent l’app)
# GOOGLE_REDIRECT_URI=https://app.ink-flow.me/dashboard
# SITE_URL / APP_URL : URL publique de l’app pour Stripe et emails (https://app.ink-flow.me en prod)

# Instagram Messaging (Meta Graph API)
# META_APP_ID=xxx
# META_APP_SECRET=xxx — obligatoire pour instagram-webhook (POST) : signature X-Hub-Signature-256
# FACEBOOK_APP_SECRET=xxx — alias accepté à la place de META_APP_SECRET
# META_WEBHOOK_VERIFY_TOKEN=xxx — token fort, identique à la config Meta (pas de valeur par défaut)
# INKFLOW_REFERRAL_INTERNAL_SECRET=xxx — optionnel : appels serveur à complete-referral sans JWT utilisateur

# Stripe (paiements)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Secrets Edge (Dashboard Supabase) : SITE_URL ou APP_URL = URL publique absolue avec schéma (https://app.… ou http://localhost:3000) — sinon Stripe Checkout renvoie url_invalid sur success_url / cancel_url.

# Resend — DEUX usages différents (ne pas confondre) :
#
# A) Edge Functions (API Resend) — RDV, messagerie, rappels, etc.
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=InkFlow <contact@ink-flow.me>
# → Secrets Supabase → Edge Functions uniquement. Ne pilote PAS les mails Auth.
#
# B) Supabase Auth — confirmation d’inscription / reset mot de passe
# → Dashboard Supabase → Authentication → SMTP (Custom SMTP), pas ce fichier.
#    Utiliser les identifiants SMTP fournis par Resend (voir docs/SUPABASE-AUTH-SMTP.md).
# Le dashboard peut tester l’envoi API via la fonction Edge send-email-test (JWT utilisateur).
# Mode Simulation (emails fictifs, compte noamdj02@gmail.com uniquement) : simulate-inkflow-experience
#
# Twilio — SMS transactionnels (optionnel) : `send-booking-confirmation` peut envoyer un court SMS + lien si le client l’a accepté sur la vitrine. Sans secrets Twilio, seul l’e-mail part.
# Secrets Supabase Edge uniquement (voir docs/CONFIGURATION.md §3.4).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# ou TWILIO_FROM_NUMBER=+33...

# SITE_URL=https://ink-flow.me
# APP_URL=https://app.ink-flow.me
# CORS Edge Functions (origines autorisées en plus de la liste fixe) — séparées par des virgules
# INKFLOW_CORS_EXTRA_ORIGINS=https://app.example.com
# LOGO_URL=https://ink-flow.me/icon.svg (optionnel)

# Cron / automation Edge — ex. POST `onboarding-automation` avec en-tête `x-cron-secret`
# Secret Supabase Edge uniquement (pas VITE_). Voir docs/ONBOARDING-MANAGER.md
# EDGE_CRON_SECRET=générer_une_chaîne_longue_aléatoire

# Anti-abus email / Edge internes — même valeur côté secrets Edge ; en-tête `X-Inkflow-Secret` sur les appels
# (notify-new-booking depuis service role, cron, etc.). Les flux dashboard tatoueur utilisent plutôt le JWT + studioId.
# INTERNAL_FUNCTION_SECRET=générer_une_chaîne_longue_aléatoire

# Web Push VAPID (notifications PWA — Option B)
# 1. npm install && npm run vapid:generate
# 2. Frontend (Vite) — même clé publique que ci-dessous, préfixe VITE_
# VITE_VAPID_PUBLIC_KEY=BNx...
# 3. Supabase Dashboard → Edge Functions → Secrets (pas dans le dépôt) :
# VAPID_PUBLIC_KEY=BNx...          (identique à VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=...          (clé privée — jamais côté client)
# VAPID_SUBJECT=mailto:noamdj02@gmail.com
# 4. Déployer : npm run deploy:function:send-push-notification && npm run deploy:function:push-subscribe
#
# Expo Push (app enveloppe Inkflow Pro — jetons dans inkflow_native_device_tokens.studio_id)
# Token créé sur https://expo.dev → ton compte → Access tokens (Bearer pour l’API push).
# Optionnel mais recommandé en prod pour quotas / diagnostics Expo.
# EXPO_ACCESS_TOKEN=xxx

# Google Maps JavaScript API (carte client « Autour de moi », géocodage, avis dashboard)
# Cle frontend distincte de GOOGLE_PLACES_API_KEY (serveur).
# Restreindre par HTTP referrer dans Google Cloud Console.
# APIs a activer : Maps JavaScript API + Geocoding API (si geocode client) + Places API (New)
# Nom recommande : VITE_GOOGLE_MAPS_JS_API_KEY — VITE_GOOGLE_MAPS_API_KEY est encore accepte (fallback).
# VITE_GOOGLE_MAPS_JS_API_KEY=AIzaSy...

# Carte fidélité Apple / Google Wallet (portail client)
# 1) Déployer : supabase functions deploy wallet-loyalty-pass
# 2) Apple : la génération .pkpass signée n’est pas encore branchée dans le repo — même avec certificats,
#    l’app affiche un message d’attente. Prévoir passkit-generator + secrets APPLE_WALLET_* (voir fonction).
# 3) Google : secret GOOGLE_WALLET_LOYALTY_SAVE_URL (URL https « Enregistrer dans Google Wallet ») si configuré.

# Gemini AI (assistant IA, suggestion de prix) - Edge Function call-gemini
# GEMINI_API_KEY=xxx

# Appeeky (audit ASO App Store — optional, agents / scripts)
# APPEEKY_API_KEY=...
