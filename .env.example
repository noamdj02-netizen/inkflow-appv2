# ============================================================
# InkFlow - Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Pour Vercel : Settings → Environment Variables
# ============================================================

# --- FRONTEND (Vite) ---
# Ces variables sont exposées côté client (préfixe VITE_)

# Supabase (OBLIGATOIRE pour auth, base de données, sync)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Stripe Billing — liens annuels (optionnel, sinon = mensuel)
# Créez des Payment Links annuels dans Stripe Dashboard et collez les URLs ici
# VITE_STRIPE_BILLING_SOLO_ANNUAL=https://buy.stripe.com/xxx
# VITE_STRIPE_BILLING_PRO_ANNUAL=https://buy.stripe.com/xxx
# VITE_STRIPE_BILLING_STUDIO_ANNUAL=https://buy.stripe.com/xxx

# --- SUPABASE EDGE FUNCTIONS (Secrets) ---
# À configurer dans : Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Ces variables ne vont PAS dans .env.local (elles sont côté serveur Supabase)

# Google Calendar OAuth
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=votre_client_secret
# GOOGLE_REDIRECT_URI=https://ink-flow.me/dashboard
# SITE_URL=https://ink-flow.me

# Instagram Messaging (Meta Graph API)
# META_APP_ID=xxx
# META_APP_SECRET=xxx
# META_WEBHOOK_VERIFY_TOKEN=inkflow_webhook_secret_xyz

# Stripe (paiements)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (emails : confirmations RDV, rappels, soins post-tattoo, notifications)
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=InkFlow <contact@ink-flow.me>
# SITE_URL=https://ink-flow.me
# APP_URL=https://app.ink-flow.me
# LOGO_URL=https://ink-flow.me/icon.svg (optionnel)

# Web Push (notifications PWA) — clé publique côté frontend
# Générer : npm run vapid:generate → mettre la clé publique ici et la privée dans Supabase Secrets
# VITE_VAPID_PUBLIC_KEY=BNx...votre_cle_publique_base64...

# Gemini AI (assistant IA, suggestion de prix) - Edge Function call-gemini
# GEMINI_API_KEY=xxx
