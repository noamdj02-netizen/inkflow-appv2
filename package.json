{
  "name": "inkflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/optimize-hero-image.mjs",
    "build": "vite build",
    "analyze": "ANALYZE=1 vite build",
    "img:webp": "node scripts/generate-public-webp-avif.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\" --ignore-path .prettierignore",
    "check:p0-supabase": "bash scripts/verify-p0-supabase-client.sh",
    "ci": "npm run lint && npm run typecheck && npm run check:p0-supabase && npm run build",
    "prepare": "husky",
    "preview": "vite preview",
    "generate-pwa-assets": "pwa-assets-generator --config pwa-assets.config.ts",
    "emit-pwa-splash-head": "node scripts/emit-pwa-apple-splash-head.mjs",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "resend:templates": "node scripts/create-resend-templates.mjs",
    "resend:test": "node --env-file=.env.local scripts/send-resend-test.mjs",
    "email:dev": "email dev --dir emails --port 3001",
    "email:confirm-preview": "node --env-file=.env.local scripts/send-auth-confirm-preview.mjs",
    "test:supabase-auth": "node --env-file=.env.local scripts/test-supabase-auth-emails.mjs",
    "email:embed-hero": "node scripts/embed-email-hero.mjs",
    "seed:mockup": "node --env-file=.env.local scripts/seed-mockup-data.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo-marketing.mjs",
    "seed:demo:clean": "node --env-file=.env.local scripts/seed-demo-marketing.mjs --clean",
    "smoke:urls": "node scripts/smoke-urls.mjs",
    "readiness:env": "node scripts/readiness.mjs env",
    "readiness:sentry": "node scripts/readiness.mjs sentry",
    "readiness:manual": "node scripts/readiness.mjs manual",
    "readiness": "npm run ci && npm run readiness:env && npm run readiness:sentry",
    "qa:audit-vite": "node scripts/qa-dashboard-ready.mjs audit-vite",
    "qa:sentry-build": "node scripts/qa-dashboard-ready.mjs sentry-build",
    "qa:quick-wins": "node scripts/qa-dashboard-ready.mjs quick-wins",
    "qa:dashboard": "node scripts/qa-dashboard-ready.mjs all",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/database.ts",
    "vapid:generate": "npx web-push generate-vapid-keys",
    "deploy:function:send-booking-confirmation": "supabase functions deploy send-booking-confirmation",
    "deploy:function:send-alternative-date-proposal": "supabase functions deploy send-alternative-date-proposal --no-verify-jwt",
    "deploy:function:stripe-webhook": "supabase functions deploy stripe-webhook --no-verify-jwt",
    "deploy:function:stripe-connect-onboarding": "supabase functions deploy stripe-connect-onboarding --no-verify-jwt",
    "deploy:function:stripe-connect-actions": "supabase functions deploy stripe-connect-actions --no-verify-jwt",
    "deploy:function:project-request-accept": "supabase functions deploy project-request-accept --no-verify-jwt",
    "deploy:function:project-request-reject": "supabase functions deploy project-request-reject --no-verify-jwt",
    "deploy:function:send-push-notification": "supabase functions deploy send-push-notification --no-verify-jwt",
    "deploy:function:push-subscribe": "supabase functions deploy push-subscribe --no-verify-jwt",
    "deploy:function:admin-founder-metrics": "supabase functions deploy admin-founder-metrics --no-verify-jwt",
    "deploy:function:onboarding-automation": "supabase functions deploy onboarding-automation --no-verify-jwt",
    "deploy:function:send-tattooer-welcome": "supabase functions deploy send-tattooer-welcome",
    "video:demo": "npm run start --prefix video/inkflow-demo",
    "video:demo:render": "npm run render --prefix video/inkflow-demo"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.5.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^0.0.29",
    "@react-email/render": "^2.0.7",
    "@sentry/nextjs": "^10.42.0",
    "@sentry/react": "^10.48.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/vite": "^4.1.18",
    "@types/luxon": "^3.7.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "ical.js": "^2.2.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "luxon": "^3.7.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.371.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.71.1",
    "react-is": "^19.2.4",
    "react-joyride": "^2.9.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@react-email/ui": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "react-email": "6.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": "prettier --write"
  }
}
